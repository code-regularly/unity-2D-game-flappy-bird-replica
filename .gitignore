# This .gitignore file should be placed at the root of your Unity project directory
#
# Base: https://github.com/github/gitignore/blob/main/Unity.gitignore
#

# Unity cache & temp
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
*.log

# Blender (backup files)
*.blend1
*.blend1.meta

# Visual Studio
.vs/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# JetBrains Rider
[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user
.consulo/
ExportedObj/

# Gradle
.gradle/

# Unity generated meta files (NOT your asset .meta files!)
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
mono_crash.*

# Build outputs
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.exe
*.x86_64
*.x86
*.Mac
*.WiiU
*.PS4
*.PSV
*.Switch
*.WebGL
*.Linux
*.Linux64
*.LinuxArm64
*.Windows
*.Windows64
*.WindowsArm64

# Crashlytics
crashlytics-build.properties

# Addressables
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/ServerData

# Temporary auto-generated Android Assets
/[Aa]ssets/StreamingAssets/aa*

# Visual Scripting auto-generated
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# UI Toolkit auto-generated
/UIElementsSchema/

# Scene dependency cache
/[Aa]ssets/SceneDependencyCache*

# TestRunner generated
InitTestScene*.unity*

# Asset Store tools (uncomment if not using)
# /[Aa]ssets/AssetStoreTools*

# ---- OS-specific ----
# macOS
.DS_Store
*.DS_Store

# Windows
Thumbs.db
Thumbs.db.meta
desktop.ini

# Linux
*~

# ---- Secrets / local config ----
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
*.pfx
*.cer
keystore/
*.keystore.meta
*.jks.meta

# ---- Git LFS (recommended for large assets) ----
# Uncomment if using Git LFS:
# *.psd
# *.psb
# *.png
# *.jpg
# *.jpeg
# *.tga
# *.exr
# *.hdr
# *.tif
# *.tiff
# *.bmp
# *.ico
